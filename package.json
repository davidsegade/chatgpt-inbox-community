{
  "name": "chatgpt-inbox",
  "version": "0.4.4",
  "description": "Create Markdown notes through a paired relay, Lite links or an advanced GitHub inbox.",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc",
    "test": "npm run build && node --test test.cjs integration.cjs source.test.cjs identity.test.cjs ui.test.cjs reception.test.cjs relay/relay.test.mjs",
    "relay": "npm run build && node relay/server.mjs",
    "verify": "npm run lint && npm run check && npm test",
    "package:community": "node tools/package-community.mjs",
    "test:postgres": "npm run build && node --test relay/postgres.test.mjs",
    "lint": "eslint '*.ts' --max-warnings 0"
  },
  "keywords": [],
  "author": "David Segade",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "obsidian@1.11.4": {
      "moment": "2.31.0"
    },
    "moment": "^2.31.0"
  }
}
